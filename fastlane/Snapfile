# Snapshot — shared defaults; lanes supply single-device lists.
# Single output root; first lane clears so later devices append.
languages(["en-US"])
scheme("ScreenVNC")
output_directory("fastlane/screenshots")
erase_simulator(true)
reinstall_app(true)
override_status_bar(true)
clear_previous_screenshots(false)
concurrent_simulators(false)
# Every lane passes localize_simulator false; the default mirrors that contract.
localize_simulator(false)
launch_arguments(["-uitesting true --create-sample-data -ScreenVNCScreenshots"])
only_testing(["ScreenVNCUITests/ScreenVNCScreenshots"])
number_of_retries(0)
