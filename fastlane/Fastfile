# Fastlane — single-device screenshot lanes fanning out to full capture.
default_platform(:ios)

# Aborts with the device list when the locked simulator is absent.
# Availability-filtered lookup from simctl JSON; never substitutes a close name.
def ensure_simulator_present(device_name, listing)
  require "json"
  parsed = JSON.parse(listing)["devices"].values.flatten
  available = parsed.select do |d|
    next false if d["isAvailable"] == false
    err = d["availabilityError"].to_s
    next false unless err.empty?
    avail = d["availability"].to_s
    next true if avail.empty?
    avail.include?("available") && !avail.include?("unavailable")
  end
  names = available.map { |d| d["name"] }.compact.uniq.sort
  unless names.include?(device_name)
    UI.user_error!("Missing simulator '#{device_name}'. Available devices:\n#{names.join("\n")}")
  end
rescue JSON::ParserError
  UI.user_error!("Unable to parse simulators for '#{device_name}'. Raw output:\n#{listing}")
end

# Non-aborting presence check sharing the availability filter above.
def simulator_available?(device_name, listing)
  require "json"
  parsed = JSON.parse(listing)["devices"].values.flatten
  parsed.any? do |d|
    next false unless d["name"] == device_name
    next false if d["isAvailable"] == false
    err = d["availabilityError"].to_s
    next false unless err.empty?
    avail = d["availability"].to_s
    next true if avail.empty?
    avail.include?("available") && !avail.include?("unavailable")
  end
rescue JSON::ParserError
  false
end

# Resolves the UDID for an available simulator, preferring newest runtime.
# Multiple simulators can share a name across runtimes; newest keeps capture current.
def udid_for_device(device_name, listing)
  require "json"
  by_runtime = JSON.parse(listing)["devices"]
  candidates = []
  by_runtime.each do |runtime, devices|
    devices.each do |d|
      next unless d["name"] == device_name
      next if d["isAvailable"] == false
      err = d["availabilityError"].to_s
      next unless err.empty?
      avail = d["availability"].to_s
      unless avail.empty?
        next unless avail.include?("available") && !avail.include?("unavailable")
      end
      candidates << [runtime, d]
    end
  end
  return nil if candidates.empty?
  candidates.sort_by do |runtime, d|
    raw = runtime.to_s[/\d[\d.\-]*/] || "0"
    version = begin
      Gem::Version.new(raw.tr("-", "."))
    rescue ArgumentError
      Gem::Version.new("0")
    end
    [version, d["state"] == "Booted" ? 1 : 0]
  end.last[1]["udid"]
rescue JSON::ParserError
  nil
end

# Erases then boots so snapshot override plus clear never see Shutdown.
# Snapshot skips its own erase via erase_simulator false, preserving booted state.
def prepare_simulator(device_name)
  listing = sh("xcrun simctl list devices -j", log: false)
  udid = udid_for_device(device_name, listing)
  ensure_simulator_present(device_name, listing) if udid.nil?
  sh("xcrun simctl shutdown \"#{udid}\" || true", log: false)
  sh("xcrun simctl erase \"#{udid}\"")
  sh("xcrun simctl boot \"#{udid}\" || true", log: false)
  sh("xcrun simctl bootstatus \"#{udid}\" -b")
  sh("open -a Simulator.app --args -CurrentDeviceUDID \"#{udid}\" || true", log: false)
  sleep 2
  udid
end

# Resolves the Outer Display devicetype only; never substitutes another type.
# nil lets the caller abort fail-closed with the full diagnostic listing.
def duo_outer_devicetype_id(devicetypes_json)
  require "json"
  types = JSON.parse(devicetypes_json)["devicetypes"] || []
  outer = types.find { |t| t["name"] == "iPhone Duo - Outer Display" }
  return outer["identifier"] if outer && outer["identifier"]
  nil
rescue JSON::ParserError
  nil
end

# Picks the newest available iOS runtime for simulator creation.
def newest_ios_runtime_id(runtimes_json)
  require "json"
  runtimes = JSON.parse(runtimes_json)["runtimes"] || []
  ios = runtimes.select do |r|
    next false if r["isAvailable"] == false
    next false if r["availability"].to_s.include?("unavailable")
    "#{r["name"]} #{r["versionString"]}".include?("iOS")
  end
  return nil if ios.empty?
  sorted = ios.sort_by do |r|
    raw = r["versionString"].to_s[/\d+(\.\d+)*/] || r["name"].to_s[/\d+(\.\d+)*/] || "0"
    begin
      Gem::Version.new(raw)
    rescue ArgumentError
      Gem::Version.new("0")
    end
  end
  sorted.last["identifier"]
rescue JSON::ParserError
  nil
end

# Creates the Outer Display simulator when absent, else aborts fail-closed.
# Never substitutes another device; the abort lists devices plus types plus runtimes.
def ensure_outer_display_simulator
  require "json"
  listing = sh("xcrun simctl list devices -j", log: false)
  return listing if simulator_available?("iPhone Duo - Outer Display", listing)
  devicetypes_json = sh("xcrun simctl list devicetypes -j", log: false)
  runtimes_json = sh("xcrun simctl list runtimes -j", log: false)
  device_type_id = duo_outer_devicetype_id(devicetypes_json)
  runtime_id = newest_ios_runtime_id(runtimes_json)
  if device_type_id.nil? || runtime_id.nil?
    names = JSON.parse(listing)["devices"].values.flatten.map { |d| d["name"] }.compact.uniq.sort
    types = JSON.parse(devicetypes_json)["devicetypes"].map { |t| t["name"] }.compact.sort
    runtimes = JSON.parse(runtimes_json)["runtimes"].map { |r| r["name"] }.compact.sort
    UI.user_error!("Missing simulator 'iPhone Duo - Outer Display' and no matching type/runtime to create it.\nAvailable devices:\n#{names.join("\n")}\nDevice types:\n#{types.join("\n")}\nRuntimes:\n#{runtimes.join("\n")}")
  end
  sh("xcrun simctl create \"iPhone Duo - Outer Display\" \"#{device_type_id}\" \"#{runtime_id}\"")
  refreshed = sh("xcrun simctl list devices -j", log: false)
  ensure_simulator_present("iPhone Duo - Outer Display", refreshed)
  refreshed
end

lane :screenshots_iphone do
  listing = sh("xcrun simctl list devices -j", log: false)
  ensure_simulator_present("iPhone 17 Pro", listing)
  prepare_simulator("iPhone 17 Pro")
  # Pre-erased plus pre-booted; first lane clears the shared root for a clean run.
  snapshot(
    devices: ["iPhone 17 Pro"],
    erase_simulator: false,
    override_status_bar: true,
    clear_previous_screenshots: true,
    localize_simulator: false,
    launch_arguments: ["-OuterViewScreenshots"]
  )
end

def hinge_bin
  File.expand_path("../Scripts/hinge", __dir__)
end

# Outer compact runs on the Outer Display simulator; inner regular runs on Duo.
lane :screenshots_duo_outer do
  ensure_outer_display_simulator
  udid = prepare_simulator("iPhone Duo - Outer Display")
  # Hinge close must succeed: a silent failure leaves inner content on the outer lane.
  sh("\"#{hinge_bin}\" -d \"#{udid}\" close")
  # Pre-erased plus pre-booted; appends so prior device output survives.
  snapshot(
    devices: ["iPhone Duo - Outer Display"],
    erase_simulator: false,
    override_status_bar: true,
    clear_previous_screenshots: false,
    localize_simulator: false,
    launch_arguments: ["-OuterViewScreenshots"]
  )
end

lane :screenshots_duo_inner do
  listing = sh("xcrun simctl list devices -j", log: false)
  ensure_simulator_present("iPhone Duo", listing)
  udid = prepare_simulator("iPhone Duo")
  sh("\"#{hinge_bin}\" -d \"#{udid}\" open")
  # Keep hinge open in background if Simulator.app or test harness resets it
  watcher_pid = Process.spawn(
    "while true; do \"#{hinge_bin}\" -d \"#{udid}\" open >/dev/null 2>&1; sleep 3; done"
  )
  begin
    # Pre-erased plus pre-booted; appends so prior device output survives.
    snapshot(
      devices: ["iPhone Duo"],
      erase_simulator: false,
      override_status_bar: true,
      clear_previous_screenshots: false,
      localize_simulator: false,
      launch_arguments: ["-OuterViewScreenshots", "-OuterViewInnerDisplay"]
    )
  ensure
    Process.kill("TERM", watcher_pid) rescue nil
    Process.wait(watcher_pid) rescue nil
  end
end

# Sequential single-root capture; only the first lane clears.
lane :screenshots_all do
  screenshots_iphone
  screenshots_duo_outer
  screenshots_duo_inner
end
